generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  pending
  confirmed
  failed
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  bookings  Booking[]

  @@map("users")
}

model Lawyer {
  // Legacy mock ids '1'..'5' kept as primary keys so the client's lawyer
  // routes and its mockData fallback keep working unchanged.
  id           String    @id
  name         String
  specialty    String
  experience   Int
  rating       Float
  hourlyRate   Int       @map("hourly_rate")
  location     String
  bio          String
  cases        Int
  successRate  Int       @map("success_rate")
  education    String
  languages    String[]
  availability String
  bookings     Booking[]

  @@map("lawyers")
}

model Booking {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  lawyerId        String        @map("lawyer_id")
  amount          Decimal       @db.Decimal(10, 2)
  transactionId   String        @map("transaction_id")
  status          BookingStatus @default(pending)
  appointmentDate String?       @map("appointment_date")
  appointmentTime String?       @map("appointment_time")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id])
  lawyer          Lawyer        @relation(fields: [lawyerId], references: [id])

  @@index([userId, status])
  @@map("bookings")
}
