# Copy to server/.env and fill in. Never commit the real .env file.

# --- Required ---

# PostgreSQL connection string. Local setup: db/role `lawweb`/`lawweb`.
DATABASE_URL=postgresql://lawweb:lawweb@127.0.0.1:5432/lawweb

# Secret used to sign/verify JWTs. The app refuses to start without this
# unless DEBUG=true (see app/security.py) — a missing secret used to fall
# back to a hardcoded literal, letting anyone forge a valid auth token.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Braintree Sandbox API keys (https://sandbox.braintreegateway.com) — needed
# for the booking/payment flow. Headless test flow uses nonce fake-valid-nonce.
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# --- Optional ---

# Frontend origins allowed to call this API (comma-separated). Defaults
# already cover the Vite dev server (client/vite.config.ts: port 3000) and
# Vite's own default (5173) — override only for a LAN IP or deployed origin.
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# When true, allows the insecure JWT_SECRET fallback and includes raw
# exception text in 500 responses. Leave false for anything demo-facing.
# DEBUG=false

HOST=0.0.0.0
PYTHON_PORT=8000

OLLAMA_BASE_URL=http://localhost:11434

# Optional: live case-law search via Indian Kanoon.
# INDIAN_KANOON_API_KEY=

# Optional: LLM-as-judge for the RAG eval script (tests/test_chatbot.py).
# The free tier allows 50 calls/day per key (1000/day after a $10 top-up); the
# second key takes over once the first reaches OPENROUTER_DAILY_LIMIT or its quota.
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_ALT=
# OPENROUTER_DAILY_LIMIT=50
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Corpus drive holding the source data (bare acts, case law, SC judgments, IL-TUR
# export); see app/data/README.md. Only index builds need it — serving runs from
# the indices in app/data/faiss_index/ with the drive unmounted.
# LAWWEB_CORPUS_ROOT=/run/media/<user>/<drive>/lawweb

# HuggingFace token for the gated IL-TUR dataset (accept the licence at
# https://huggingface.co/datasets/Exploration-Lab/IL-TUR); used by
# app/ingest/iltur_export.py and the IL-TUR eval.
# HUGGINGFACE_TOKEN=

# Optional: Cloudflare R2 (S3-compatible) for the document vault. If unset,
# vault storage falls back to local disk under app/data/vault/.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=lawweb-vault
# R2_ENDPOINT_URL=

# Optional: SMTP for email notifications. Left blank, notifications are
# logged instead of sent — safe local-dev default.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=no-reply@lawweb.local

# Currency Braintree actually charges (sandbox merchants are USD).
# CURRENCY=USD

# Set false for LLMs that answer directly instead of opening a <think> block.
# LLM_THINKING=true

# Optional: browser push (Firebase Cloud Messaging).
# FCM_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# FIREBASE_WEB_CONFIG_JSON={"apiKey":"...","projectId":"...","messagingSenderId":"...","appId":"..."}
# FIREBASE_VAPID_KEY=

# Optional: Google / Outlook calendar sync (OAuth). PUBLIC_API_URL is where the
# browser reaches this server; CLIENT_APP_URL is where users land afterwards.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# PUBLIC_API_URL=http://localhost:8000
# CLIENT_APP_URL=http://localhost:3000
# TOKEN_ENC_KEY=
